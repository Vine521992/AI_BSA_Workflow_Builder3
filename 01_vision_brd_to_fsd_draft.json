    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r=$input.first().json;\nlet html=\"\";\nfor (const o of (r.output ?? [])) for (const c of (o.content ?? [])) if (c.type === \"output_text\") html += c.text;\nif (!html) throw new Error(\"No output_text returned by Responses API. Inspect response: \" + JSON.stringify(r).slice(0,3000));\nhtml=html.replace(/^```html\\s*/i,\"\").replace(/```\\s*$/i,\"\");\nconst src=$(\"Build Responses API request\").item.json;\nreturn [{json:{html,sourcePath:src.sourcePath,sourceFileName:src.sourceFileName}}];"
      },
