    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const pdf=await this.helpers.getBinaryDataBuffer(0,'data');\nconst src=$(\"Extract generated FSD HTML\").item.json;\nconst base=src.sourceFileName.replace(/\\.(pdf|png|jpe?g)$/i,\"\").replace(/[^A-Za-z0-9_-]+/g,\"_\");\nconst stamp=new Date().toISOString().replace(/[-:]/g,\"\").replace(/\\.\\d{3}Z$/, \"Z\");\nconst fileName=`${base}_FSD_DRAFT_${stamp}.pdf`;\nconst outputPath=`output/fsd/draft/${fileName}`;\nconst manifestPath=`output/fsd/draft/${base}_FSD_DRAFT_${stamp}_REVIEW.md`;\nconst manifest=`# FSD draft review\\n\\n- Source: ${src.sourcePath}\\n- Draft PDF: ${outputPath}\\n- Status: DRAFT \u2014 BA review required\\n\\nReview the PDF for completeness, traceability, accuracy, assumptions and open questions. Do not treat this as approved.\\n\\nTo approve, create a text file in \\`input/APPROVAL/\\` named \\`${base}_FSD_DRAFT_${stamp}.approve\\`. Its content must be the exact draft path: \\`${outputPath}\\`. Commit the marker to \\`main\\`. The separate approval workflow will copy it to \\`output/fsd/approved/\\`.`;\nreturn {json:{outputPath,fileName,sourcePath:src.sourcePath,pdfBase64:pdf.toString('base64'),manifestPath,manifestBase64:Buffer.from(manifest,'utf8').toString('base64')}};"
      },
