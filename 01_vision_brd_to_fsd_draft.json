    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const event = $input.first().json.body ?? $input.first().json;\nif (event.ref && event.ref !== 'refs/heads/main') return [];\nconst commits = event.commits ?? [];\nconst paths = [...new Set(commits.flatMap(c => [...(c.added ?? []), ...(c.modified ?? [])]))];\nconst known = ['HUMANA','CENTERWELL','EISAI'];\nreturn paths.filter(path => path.startsWith('input/IMAGE/') && /\\.(pdf|png|jpe?g)$/i.test(path)).map(path => { const name=path.split('/').pop(); const prefix=name.includes('__')?name.split('__')[0].toUpperCase():'UNIVERSAL'; const projectKey=known.includes(prefix)?prefix:'UNIVERSAL'; return {json:{owner:'Vine521992',repo:'AI_BSA_Workflow_Builder3',branch:'main',path,sourceFileName:name,projectKey,mimeType:/\\.pdf$/i.test(path)?'application/pdf':/\\.png$/i.test(path)?'image/png':'image/jpeg'}}; });"
      },
