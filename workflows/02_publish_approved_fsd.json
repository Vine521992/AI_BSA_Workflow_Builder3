{
  "name": "02 - Publish BA Approved FSD",
  "nodes": [
    {
      "parameters": {
        "owner": {
          "__rl": true,
          "mode": "name",
          "value": "Vine521992"
        },
        "repository": {
          "__rl": true,
          "mode": "name",
          "value": "AI_BSA_Workflow_Builder3"
        },
        "events": [
          "push"
        ],
        "authentication": "accessToken"
      },
      "id": "2bfbd463-ae18-4a13-bc56-f454bc80ab1e",
      "name": "GitHub Approval Push Trigger",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "credentials": {
        "githubApi": {
          "name": "CONFIGURE - GitHub Trigger"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const e=$input.first().json.body??$input.first().json; if(e.ref && e.ref!==\"refs/heads/main\") return []; const cs=e.commits??[]; const ps=[...new Set(cs.flatMap(c=>[...(c.added??[]),...(c.modified??[])]))]; return ps.filter(p=>p.startsWith(\"input/APPROVAL/\") && p.endsWith(\".approve\")).map(p=>({json:{markerPath:p}}));"
      },
      "id": "87b458eb-966f-470a-98df-1c1ad0c6742e",
      "name": "Filter approval markers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/Vine521992/AI_BSA_Workflow_Builder3/contents/{{ $json.markerPath }}?ref=main",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        }
      },
      "id": "56354649-2155-4025-9f6b-c5b27b8f3002",
      "name": "Read approval marker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "CONFIGURE - GitHub REST API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j=$input.first().json; const p=Buffer.from(j.content,\"base64\").toString(\"utf8\").trim(); if(!p.startsWith(\"output/fsd/draft/\")||!p.endsWith(\".pdf\")) throw new Error(\"Approval marker must contain a path under output/fsd/draft ending in .pdf\"); return {json:{draftPath:p,approvedPath:p.replace(\"output/fsd/draft/\",\"output/fsd/approved/\").replace(\"_DRAFT_\",\"_APPROVED_\")}};"
      },
      "id": "8f1fc689-1d03-40df-9c31-0b183bfefd38",
      "name": "Resolve approved draft path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/Vine521992/AI_BSA_Workflow_Builder3/contents/{{ encodeURIComponent($json.draftPath).replace(/%2F/g, '/') }}?ref=main",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github.raw"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        }
      },
      "id": "e917d213-a4d2-4819-a7ce-4d89cf646fc2",
      "name": "Download approved draft PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "CONFIGURE - GitHub REST API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b=await this.helpers.getBinaryDataBuffer(0,\"data\"); const src=$(\"Resolve approved draft path\").item.json; return {json:{approvedPath:src.approvedPath,content:b.toString(\"base64\")}};"
      },
      "id": "2416ae9c-e8f6-43f7-bec5-4e03755a849d",
      "name": "Prepare approved PDF payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://api.github.com/repos/Vine521992/AI_BSA_Workflow_Builder3/contents/{{ $json.approvedPath }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({message:\"BA-approved FSD publication\",content:$json.content,branch:\"main\"}) }}"
      },
      "id": "8778b8d8-9ccb-4e58-92ff-8b577750e8d9",
      "name": "Publish approved FSD to GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "name": "CONFIGURE - GitHub REST API"
        }
      }
    }
  ],
