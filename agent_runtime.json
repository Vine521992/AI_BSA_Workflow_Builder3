{
  "version": "1.0.0",
  "default_project": "UNIVERSAL",
  "brand": "Internal BA Automation Framework",
  "brand_tokens_path": "config/brand/brand_tokens.json",
  "brand_guidelines_path": "config/brand/brand_guidelines.md",
  "voice_path": "config/voice/writing_voice.md",
  "standards_path": "config/standards/BA_documentation_standards.md",
  "template_path": "templates/FSD_Template.html",
  "project_selection": {
    "rule": "Optional filename prefix PROJECTKEY__filename.ext; if no recognized prefix, use UNIVERSAL defaults.",
    "known_projects": [
      "HUMANA",
      "CENTERWELL",
      "EISAI"
    ],
    "fallback": "UNIVERSAL"
  },
  "publishing": {
    "draft_path": "output/fsd/draft/",
    "approved_path": "output/fsd/approved/",
    "approval_marker_path": "input/APPROVAL/",
    "approval_marker_content": "Exact relative path of the draft PDF. Approval marker commit is the human approval action."
  },
  "input": {
    "path": "input/IMAGE/",
    "extensions": [
      ".pdf",
      ".png",
      ".jpg",
      ".jpeg"
    ]
  },
  "model": {
    "provider": "OpenAI Responses API",
    "model": "gpt-4.1",
    "image_detail": "high"
  }
}